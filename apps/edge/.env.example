# ─── Identity ───────────────────────────────────────────────────────────
# Leave DEVICE_ID empty on first boot: a stable UUID is generated and
# persisted in $DATA_DIR/device_id automatically.
DEVICE_ID=
# Token issued by the HosT.ia cloud when the device is provisioned.
DEVICE_TOKEN=change-me

# ─── Cloud endpoints ────────────────────────────────────────────────────
CLOUD_API=https://api.hostia.com
POS_API=http://localhost:8001

# ─── Storage ────────────────────────────────────────────────────────────
DATA_DIR=/var/lib/hostia-edge
APP_DIR=/opt/hostia-edge/current

# ─── Camera ─────────────────────────────────────────────────────────────
CAMERA_ENABLED=true
# USB webcam: numeric index ("0"). IP camera: "rtsp://user:pass@ip:554/stream"
CAMERA_SOURCE=0
CAMERA_FPS=15
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_RECONNECT_SECONDS=5

# ─── Video buffer (24h rolling) ─────────────────────────────────────────
SEGMENT_SECONDS=60
RETENTION_HOURS=24
MAX_STORAGE_GB=8
PRUNE_INTERVAL=300

# ─── Local motion analysis ──────────────────────────────────────────────
MOTION_ENABLED=true
MOTION_THRESHOLD=8.0
MOTION_COOLDOWN_SECONDS=30
MOTION_FRAME_SKIP=5

# ─── Cloud sync / heartbeat / OTA ───────────────────────────────────────
SYNC_INTERVAL=30
SYNC_BATCH_SIZE=50
HEARTBEAT_INTERVAL=60
REQUEST_TIMEOUT=15
UPDATE_ENABLED=true
UPDATE_CHANNEL=stable
UPDATE_INTERVAL=21600

# ─── Local offline API (POS tablets on the LAN) ─────────────────────────
LOCAL_API_ENABLED=true
LOCAL_API_HOST=0.0.0.0
LOCAL_API_PORT=8090
# Optional shared secret; clients must send header "X-Edge-Key".
LOCAL_API_KEY=

# ─── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
