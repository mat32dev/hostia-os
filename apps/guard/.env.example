# ─── Application ───
APP_NAME=Host.ia Guard
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/v1
CORS_ORIGINS=*

# ─── Database / queue ───
DATABASE_URL=postgresql://hostia:hostia_dev@postgres:5432/hostia_os
REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=        # defaults to REDIS_URL
# CELERY_RESULT_BACKEND=    # defaults to REDIS_URL

# ─── Storage (MinIO / S3) ───
STORAGE_BACKEND=minio        # minio | local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=hostia
MINIO_SECRET_KEY=hostia_dev_123
MINIO_SECURE=false
MINIO_BUCKET_VIDEOS=guard-videos
MINIO_BUCKET_FRAMES=guard-frames
LOCAL_STORAGE_DIR=./data     # used when STORAGE_BACKEND=local
MAX_UPLOAD_MB=500

# ─── Models ───
YOLO_MODEL_PATH=models/cash-yolov8n.pt   # custom weights (hands/cash/POS)
YOLO_FALLBACK_MODEL=yolov8n.pt           # COCO fallback
YOLO_CONFIDENCE=0.35
HF_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct
VLM_MAX_NEW_TOKENS=256
DEVICE=auto                  # auto | cuda | cpu | mps
USE_MOCK_MODELS=false        # true = deterministic heuristic models (dev/tests)

# ─── Frame extraction ───
FRAME_EXTRACTION_FPS=2.0
ACTIVITY_THRESHOLD=8.0       # mean abs pixel diff (0-255); lower = more frames kept
ACTIVITY_PADDING=1
MAX_FRAMES_PER_VIDEO=60

# ─── Event building ───
EVENT_GAP_TOLERANCE_S=3.0
MIN_EVENT_CONFIDENCE=0.30

# ─── POS matching ───
MATCH_WINDOW_SECONDS=180
MIN_MATCH_CONFIDENCE=0.50
AMOUNT_MISMATCH_TOLERANCE=5.0
HIGH_AMOUNT_MISMATCH=50.0
CURRENCY=EUR

# ─── Alerts ───
CRITICAL_UNREGISTERED_AMOUNT=200.0
ALERT_REPEAT_WINDOW_HOURS=24
ALERT_REPEAT_THRESHOLD=3

# ─── RLHF feedback loop ───
FEEDBACK_MIN_SAMPLES=20
FEEDBACK_WINDOW=200
FEEDBACK_EXPORT_PATH=rlhf/dataset.jsonl
