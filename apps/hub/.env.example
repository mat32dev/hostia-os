# ─── Host.ia Hub — Environment ───────────────────────────────────────────────
# Copy to .env.local for local development.

# Server-side proxy targets (used by next.config.js rewrites).
# The browser never calls these directly; it uses same-origin /api/* routes.
# When running inside docker-compose, use the service names instead:
#   POS_API_URL=http://pos-api:8000
#   GUARD_API_URL=http://guard-api:8000
#   CHAT_API_URL=http://chat-api:3001
POS_API_URL=http://localhost:8001
GUARD_API_URL=http://localhost:8002
CHAT_API_URL=http://localhost:3001

# Public fallbacks (kept for compatibility with the root docker-compose.yml,
# which injects NEXT_PUBLIC_* variables into this service).
NEXT_PUBLIC_POS_API=http://localhost:8001
NEXT_PUBLIC_GUARD_API=http://localhost:8002
NEXT_PUBLIC_CHAT_API=http://localhost:3001

# Tenant this dashboard instance manages.
NEXT_PUBLIC_TENANT_ID=1

# Optional: developer auto-login hint shown on the Account settings tab.
# Never set these in production.
NEXT_PUBLIC_DEV_EMAIL=
NEXT_PUBLIC_DEV_PASSWORD=
